# Cloud Lab Platform - Environment Configuration
# Copy this to .env and fill in your values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
ENVIRONMENT=dev
APP_NAME=Cloud Lab Platform
APP_DESCRIPTION=Identity and access management platform
APP_VERSION=0.1.0
SERVER_PORT=8000
FRONTEND_URL=http://localhost:5173
PLATFORM_ORGANIZATION_NAME=Cloud Lab Platform

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cloud_lab

# Optional: separate migration database with owner role
# MIGRATION_DATABASE_URL=postgresql://owner:password@localhost:5432/cloud_lab

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
AUTO_MIGRATE=true

# ============================================================================
# AUTHENTICATION & JWT
# ============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_ACCESS_SECRET=your-secret-key-at-least-32-characters-long-change-me
JWT_REFRESH_SECRET=your-other-secret-key-at-least-32-characters-long-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# MFA/2FA Settings
MFA_SECRET_KEY=your-mfa-encryption-key-32-chars
REQUIRE_EMAIL_VERIFICATION=false  # true in production
MFA_PERIOD_SECONDS=30
MFA_RECOVERY_CODE_COUNT=8

# Account Security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TEMPORARY_PASSWORD_TTL_DAYS=7
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_RESEND_COOLDOWN_SECONDS=60
KNOWN_DEVICES_LIMIT=20
AUDIT_EMAIL_RETENTION_DAYS=90
AUDIT_RETENTION_YEARS=7

# ============================================================================
# GOOGLE OAUTH (SSO)
# ============================================================================
# Setup: https://console.cloud.google.com/
# 1. Create project
# 2. Enable OAuth consent screen
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add redirect URI: http://localhost:8000/api/v1/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/google

# ============================================================================
# MICROSOFT/AZURE AD OAUTH (SSO)
# ============================================================================
# Setup: https://portal.azure.com/
# 1. App registrations → New registration
# 2. Create application
# 3. Add client secret
# 4. Add redirect URI: http://localhost:8000/api/v1/auth/callback/microsoft

MICROSOFT_CLIENT_ID=your-azure-app-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/microsoft
MICROSOFT_TENANT=common  # or your specific tenant ID

# ============================================================================
# EMAIL / BREVO TRANSACTIONAL API
# ============================================================================
# Setup: https://www.brevo.com (formerly Sendinblue)
# Free tier available, 300 emails/day

EMAIL_FROM=Cloud Lab Platform <noreply@example.com>
BREVO_API_KEY=your-brevo-api-key
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_SEND_ATTEMPTS=3
EMAIL_RETRY_MINUTES=1,5,15,60,180,360
EMAIL_OUTBOX_POLL_SECONDS=10
EMAIL_BACKLOG_WARN_SECONDS=900
EMAIL_OUTBOX_KEEP_DAYS=30
EMAIL_RECIPIENT_HOURLY_LIMIT=20
EMAIL_DEDUPE_SECONDS=60

# Company info (required for email compliance)
COMPANY_LEGAL_NAME=Cloud Lab Platform
COMPANY_MAILING_ADDRESS=123 Main St, City, State 12345
COMPANY_CONTACT_EMAIL=support@example.com

# ============================================================================
# RATE LIMITING (REDIS)
# ============================================================================
# Redis connection string for rate limiting and caching
# Format: redis://[user:password@]host:port/db

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

# Rate limits format: {"name": [calls, seconds]}
# Example: {"auth": [120, 60]} = 120 calls per 60 seconds
RATE_LIMITS={}  # Uses defaults from config.py

# ============================================================================
# CORS & SECURITY
# ============================================================================
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
TRUSTED_PROXIES=127.0.0.1  # Load balancer IPs
MAX_REQUEST_BODY_BYTES=65536  # 64 KB
MAX_LARGE_BODY_BYTES=262144   # 256 KB

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
NO_COLOR=false  # Set to true to disable colored output
FORCE_COLOR=false

# ============================================================================
# DEVELOPMENT
# ============================================================================
# Only use in development!
DEBUG=false
TESTING=false
